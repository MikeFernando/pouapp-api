PORT=3333
NODE_ENV=development
CORS_ORIGIN=*
JWT_SECRET=troque-este-segredo-com-pelo-menos-32-chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d
JWT_ISSUER=pouapp-api
JWT_AUDIENCE=pouapp
# Protects PUT /admin/license (activate/block a tenant after Stripe payment)
LICENSE_ADMIN_KEY=dev-license-admin-key
# Free days after register; 0 = blocked until Stripe payment
LICENSE_TRIAL_DAYS=0
# Local JSON store (users, licenses, sessions) — no paid database
DATA_DIR=./data
# Stripe (Payment Link + webhook). Leave empty until connected.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Days to unlock after checkout if invoice period is not ready yet
STRIPE_FALLBACK_PAID_DAYS=31
